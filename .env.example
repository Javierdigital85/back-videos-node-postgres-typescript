# ========================================
# ENTORNO
# ========================================
# Valores: "development" o "production"
NODE_ENV=development

# ========================================
# DATABASE
# ========================================
# En DEVELOPMENT: usa localhost
# En PRODUCTION: usa el pooler de Supabase (aws-X-XX-XXXX.pooler.supabase.com)
DIALECT=postgres
HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_password

# ========================================
# SERVER
# ========================================
# Puerto del servidor (8000 en dev, 5000 en prod por defecto)
PORT=8000

# ========================================
# SECURITY
# ========================================
SECRET=your_jwt_secret

# ========================================
# FRONTEND
# ========================================
# En DEVELOPMENT: Opcional (default: http://localhost:5173)
# En PRODUCTION: OBLIGATORIO - URL del frontend desplegado
# Usado para:
#   - CORS: Permitir requests del frontend
#   - Email: Link de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# ========================================
# EMAIL
# ========================================
# DESARROLLO: Usar Nodemailer (SMTP con Gmail)
# Genera una App Password en: https://myaccount.google.com/apppasswords
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_EMAIL=your_email@gmail.com
NODEMAILER_PASS=your_app_password_here

# PRODUCCIÓN: Usar Resend (para Render)
# Regístrate en: https://resend.com/signup
# Obtén tu API Key en: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nota: Render bloquea puertos SMTP (465, 587)
# En producción, usa Resend (API HTTP - puerto 443)
# Resend permite usar onboarding@resend.dev sin verificar dominio

